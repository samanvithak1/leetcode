
class Solution {
    public String convert(String s, int numRows) {
        if (numRows == 1) {
            return s;
        }

        String result = "";

        for (int i = 0; i < numRows; i++) {
            int j = i;
            boolean down = true;

            while (j < s.length()) {
                result += s.charAt(j);

                if (i == 0 || i == numRows - 1) {
                    j += 2 * (numRows - 1);
                } else {
                    if (down) {
                        j += 2 * (numRows - i - 1);
                    } else {
                        j += 2 * i;
                    }
                    down = !down;
                }
            }
        }

        return result;
    }
}
